{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "air-stat-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "air-stat-db",
      "database_id": "259c5d62-fea4-408c-b8ac-60fe11c875ae"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "17 2 * * *"]
  }
}
