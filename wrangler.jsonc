{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "air-stat-api",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "air-alert-stat.com",
      "custom_domain": true
    },
    {
      "pattern": "www.air-alert-stat.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/",
      "/progress",
      "/progress/",
      "/sitemap.xml",
      "/stats",
      "/stats/*",
      "/en/stats",
      "/en/stats/*",
      "/open-data/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "air-stat-db",
      "database_id": "259c5d62-fea4-408c-b8ac-60fe11c875ae"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["* * * * *", "17 2 * * *"]
  }
}
